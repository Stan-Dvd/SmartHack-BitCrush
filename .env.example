DATABASE_URL=postgresql://postgres:postgres@localhost:5433/urbanev
H3_RES8=8
H3_RES9=9
PUMP_RATING_KW=50
SNAPSHOT_MINUTES=5
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
TIMEZONE=Europe/Bucharest
PREDICTIE_N_PILES_DEFAULT=2
PREDICTIE_POWER_KW_DEFAULT=50
H3_GRID_RES=8
H3_GRID_MIN_POP=100
RAPORT_POP_JUDET_SUSPECT=2.0
# Agent AI: cheie gratuită de la https://aistudio.google.com (free tier; datele pot fi folosite de Google)
# (se acceptă și numele GOOGLE_API_KEY sau GOOGLE_MAPS_API_KEY)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# model folosit automat dacă cel principal e supraîncărcat (503); gol = fără rezervă
GEMINI_MODEL_REZERVA=gemini-3.5-flash-lite
AGENT_MAX_PASI=8
