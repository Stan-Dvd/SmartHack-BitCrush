DATABASE_URL=postgresql://postgres:postgres@localhost:5433/urbanev
H3_RES8=8
H3_RES9=9
PUMP_RATING_KW=50
SNAPSHOT_MINUTES=5
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
TIMEZONE=Europe/Bucharest
PREDICTIE_N_PILES_DEFAULT=2
PREDICTIE_POWER_KW_DEFAULT=50
H3_GRID_RES=8
H3_GRID_MIN_POP=100
RAPORT_POP_JUDET_SUSPECT=2.0
# Agent AI: furnizorul modelului de limbaj (openai | gemini)
LLM_PROVIDER=openai
# OpenAI (Responses API), cheie de la https://platform.openai.com/api-keys (plătit per utilizare)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# model folosit automat la erori trecătoare (5xx, timeout); gol = fără rezervă
OPENAI_MODEL_REZERVA=gpt-6-luna
OPENAI_REASONING_EFFORT=low
# Gemini (dacă LLM_PROVIDER=gemini); se acceptă și GOOGLE_API_KEY sau GOOGLE_MAPS_API_KEY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_REZERVA=gemini-3.5-flash-lite
AGENT_MAX_PASI=8
